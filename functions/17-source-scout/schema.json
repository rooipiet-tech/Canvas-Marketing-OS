{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmos.dev/schemas/function-definition/v1/17-source-scout/schema.json",
  "title": "Source Scout I/O",
  "description": "Input/output contract for function 17. Output is a single JSON object of candidate sources to probe. A proposal is a hypothesis for the probe to test, never an assertion that a source is reachable or good.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "profile_id",
        "topic"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 3
        },
        "topic": {
          "type": "string",
          "minLength": 10
        },
        "watchlist_note": {
          "type": "string",
          "description": "The profile's own watchlist prose, which often names publications."
        },
        "existing_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sources already live on this profile \u2014 never re-propose one."
        },
        "existing_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sources already awaiting a probe \u2014 never re-propose one."
        },
        "competitors": {
          "type": "array",
          "description": "The named competitor set from functions/_shared/competitor-register.yaml, passed only for profiles marked needs_competitor_register. Present so the scout can propose a competitor's own newsroom for a profile whose watchlist asks for competitor-owned channels; a `category` entry has no newsroom to propose.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "kind": {
                "enum": [
                  "firm",
                  "product",
                  "category"
                ]
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "profile_id",
        "candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "candidates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "url",
              "publisher",
              "source_kind",
              "rationale",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "publisher": {
                "type": "string",
                "minLength": 2
              },
              "source_kind": {
                "enum": [
                  "rss",
                  "news-page",
                  "vendor-newsroom",
                  "tender-portal",
                  "regulator",
                  "trade-body"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 20
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        }
      }
    }
  }
}
