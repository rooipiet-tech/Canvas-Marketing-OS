{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmos.dev/schemas/function-definition/v1/18-01-vertical-intel-logistics-fleet/schema.json",
  "title": "Vertical Intelligence - Logistics & Fleet/Telematics I/O",
  "description": "Input/output contract for function 18-01-vertical-intel-logistics-fleet. Output is a single JSON object of source-attributed opportunity/threat cards.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "topic",
        "horizon_days"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 3
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "Optional seed source URLs to prioritise."
        },
        "thin_evidence": {
          "type": "boolean",
          "default": false,
          "description": "Set when the caller already knows retrieval returned single-source or vendor-self-reported material."
        },
        "client_reference": {
          "type": "string",
          "description": "Optional client name a caller might mention. Never emitted in output - see prompt.md's client-naming rule."
        },
        "watchlist_note": {
          "type": "string",
          "description": "Optional free-text steer for this vertical's watchlist; never a substitute for a retrievable source."
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "topic",
        "horizon_days",
        "summary",
        "cards",
        "vertical"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string"
        },
        "horizon_days": {
          "type": "integer"
        },
        "summary": {
          "type": "string",
          "minLength": 40
        },
        "cards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "headline",
              "so_what",
              "source_url",
              "card_type",
              "taxonomy",
              "evidence_grade",
              "confidence"
            ],
            "additionalProperties": false,
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 10
              },
              "so_what": {
                "type": "string",
                "minLength": 10
              },
              "source_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "card_type": {
                "enum": [
                  "opportunity",
                  "threat"
                ]
              },
              "taxonomy": {
                "enum": [
                  "cfo-pain-signal",
                  "fabric-conversation",
                  "sage-ecosystem-signal",
                  "tender-signal",
                  "vertical-competitor-move",
                  "other"
                ]
              },
              "evidence_grade": {
                "enum": [
                  "strong",
                  "moderate",
                  "light"
                ]
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            }
          }
        },
        "vertical": {
          "const": "Logistics & Fleet/Telematics"
        }
      }
    }
  }
}
