{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmos.dev/schemas/function-definition/v1/42-linkedin-post-writer/schema.json",
  "title": "LinkedIn Post Writer I/O",
  "description": "Input/output contract for function 42. Output is the post body as plain text, closing with the roof line.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": ["pillar", "proof_point", "campaign"],
      "additionalProperties": false,
      "properties": {
        "pillar": {
          "enum": [
            "Finance-grade trust",
            "Consolidation at scale",
            "Fabric-native",
            "Productised speed",
            "Beyond the dashboard"
          ]
        },
        "proof_point": {
          "type": "string",
          "minLength": 10,
          "description": "A client, a number or an artefact. Required — there is no assertion-only path."
        },
        "campaign": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "utm_campaign value for the single call to action."
        },
        "audience_note": {"type": "string"},
        "client_reference": {
          "type": "string",
          "description": "Optional client name the caller wants named. Only used if function 02 confirms CLEARED status; otherwise the post is written client-free."
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["post", "pillar", "cta_url"],
      "additionalProperties": false,
      "properties": {
        "post": {"type": "string", "minLength": 200},
        "pillar": {"type": "string"},
        "cta_url": {
          "type": "string",
          "pattern": "^https://www\\.canvasintelligence\\.com/"
        }
      }
    }
  }
}
